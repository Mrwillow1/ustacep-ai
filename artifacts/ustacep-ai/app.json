{
  "expo": {
    "name": "UstaCep AI",
    "slug": "ustacep-ai",
    "owner": "mrwillows-team",
    "version": "1.0.0",
    "extra": {
      "eas": {
        "projectId": "d4e3d09c-8ba0-467c-8d92-5c4a2118e35f"
      }
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ustacep-ai",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#10243E"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.ustacep.ai",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#10243E"
      },
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "cameraPermission": "UstaCep AI'nin iş fotoğrafı çekebilmesi için kameranıza erişim gerekir.",
          "photosPermission": "UstaCep AI'nin iş fotoğraflarını seçebilmesi için fotoğraflarınıza erişim gerekir."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
